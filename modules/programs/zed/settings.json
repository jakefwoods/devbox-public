{
  "cli_default_open_behavior": "existing_window",
  "agent_servers": {
    "claude-acp": {
      "type": "registry",
    },
  },
  "auto_install_extensions": {
    "nix": true,
  },
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
  },
  "base_keymap": "JetBrains",
  "vim_mode": true,
  "which_key": {
    "enabled": true,
    "delay_ms": 250,
  },
  "theme": {
    "mode": "system",
    "light": "One Light",
    "dark": "One Dark",
  },
  "close_panel_on_toggle": true,
  "languages": {
    "Nix": {
      "language_servers": ["nixd", "!nil"],
    },
  },
  "lsp": {
    "nixd": {
      "settings": {
        "diagnostic": {
          "suppress": ["sema-unused-def-lambda-noarg-formal"],
        },
      },
    },
  },
}
